# Copy to .env for local (non-Docker) development.
# docker compose supplies these directly, so .env is only for `pnpm dev`.

NODE_ENV=development

# Postgres. Used by the Prisma CLI via prisma.config.ts and by the app at runtime.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/payroll?schema=public"

# Redis, backing BullMQ.
REDIS_URL="redis://localhost:6379"

PORT=3001

# Jobs one worker process handles in parallel (across different employees).
WORKER_CONCURRENCY=5

# BullMQ attempts before an event is marked permanently FAILED.
MAX_ATTEMPTS=5

# Probability the simulated payroll provider throws a transient error (0..1).
# Set to 0 for deterministic tests, raise it to demo retry/dead-lettering.
PAYROLL_FAILURE_RATE=0.25

LOG_LEVEL=info
